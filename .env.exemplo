# Configuração do container do Comunicação DP.
# Copie para ".env" (o instalar.sh faz isso sozinho) e ajuste o que precisar.
# Este arquivo tem senha: não compartilhe e não coloque em repositório.

# Porta no servidor Linux. Dentro do container é sempre 3000.
PORTA=3000

# Primeiro login da Central, criado só se o banco ainda estiver vazio.
# Depois do primeiro acesso a senha fica no banco (com hash) e esta linha pode ser apagada.
ADMIN_USERNAME=ti
ADMIN_PASSWORD=
ADMIN_NAME=TI

# fatal, error, warn, info, debug ou trace
LOG_LEVEL=info

TZ=America/Sao_Paulo

# Validade dos logins, em horas
SESSION_TTL_HOURS=12
EMPLOYEE_SESSION_HOURS=12

# Só preencha se houver um proxy reverso com HTTPS na frente (nginx, Traefik, Caddy).
# Use o IP do proxy, ex.: 172.18.0.1
TRUST_PROXY=
