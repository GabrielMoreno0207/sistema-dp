# Ambiente: development | production
NODE_ENV=development

# Endereço de escuta. 0.0.0.0 aceita conexões de qualquer máquina da rede interna.
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Banco de dados: PostgreSQL, obrigatório (o backend não sobe sem esta linha).
# Rodando fora do Docker, aponte para a porta que o banco expõe no servidor;
# dentro do Docker o endereço é o nome do container, na porta 5432:
#   DATABASE_URL=postgresql://sistema_dp:SUA_SENHA@sistema-dp-postgres:5432/sistema_dp
DATABASE_URL=postgresql://sistema_dp:SUA_SENHA@localhost:5433/sistema_dp
# Schema onde ficam as tabelas
DATABASE_SCHEMA=dp

# Pastas dos arquivos. Caminhos relativos partem da pasta backend/.
# Inclua-as no backup, junto com o banco: o conteúdo NÃO está dentro do banco.
# anexos dos comunicados
UPLOADS_PATH=./data/uploads
# imagens e vídeos do mural, fotos de perfil e arquivos do chat
MIDIAS_PATH=./data/midias
# instaladores publicados pelo versionador
UPDATES_PATH=./data/atualizacoes

# ------------------------------------------------------------------------------------------
# OBRIGATÓRIO trocar a senha abaixo: o backend NÃO sobe com o valor de exemplo.
# ------------------------------------------------------------------------------------------

# Primeiro usuário do DP para entrar na Central (criado só se o banco ainda não tiver nenhum).
# Depois de criado, a senha fica guardada (com hash) no banco e esta linha pode ser removida.
# Para trocar a senha depois: npm run set-password -- admin
ADMIN_USERNAME=ti
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=TI

# Validade da sessão de login da Central do DP, em horas.
SESSION_TTL_HOURS=12

# Validade da sessão do funcionário no aplicativo, em horas (PCs compartilhados: se esquecer
# de sair, a sessão acaba sozinha). O app também sai no logoff do Windows.
# Login do funcionário persiste (reiniciar o PC não desloga). Sai sozinho só depois
# de tantos dias sem o aparelho conectar; para trocar de pessoa, "Sair" no app.
SESSAO_DIAS_SEM_USO=30

# ------------------------------------------------------------------------------------------
# HTTPS (recomendado em produção) — escolha UMA das opções. Veja "HTTPS" no README.
# ------------------------------------------------------------------------------------------

# Opção A: HTTPS direto no backend (certificado emitido pela TI / AD CS da empresa)
# TLS_CERT_FILE=./certs/servidor.crt
# TLS_KEY_FILE=./certs/servidor.key

# Opção B: atrás de um proxy reverso com HTTPS (IIS, nginx, Caddy): IP(s) do proxy
# TRUST_PROXY=127.0.0.1
