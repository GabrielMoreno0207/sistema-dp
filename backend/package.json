{
  "name": "sistema-dp-backend",
  "version": "1.1.0",
  "description": "Backend do sistema de comunicação interna do Departamento Pessoal",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "set-password": "tsx --disable-warning=ExperimentalWarning src/scripts/set-password.ts",
    "db:init": "tsx --disable-warning=ExperimentalWarning src/scripts/init-db.ts",
    "create-admin": "tsx --disable-warning=ExperimentalWarning src/scripts/create-admin.ts",
    "liberar-pc": "tsx --disable-warning=ExperimentalWarning src/scripts/liberar-pc.ts",
    "migrar-postgres": "tsx --disable-warning=ExperimentalWarning src/scripts/migrar-para-postgres.ts",
    "test:postgres": "tsx --disable-warning=ExperimentalWarning --test test/api.test.ts test/conteudo.test.ts test/chamados.test.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
