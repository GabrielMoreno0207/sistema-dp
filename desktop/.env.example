# Endereço do backend (nunca fixe o IP no código).
# Em desenvolvimento, este arquivo fica na pasta desktop/.
# Na instalação, pode ser colocado ao lado do executável "ComunicacaoDP.exe".
# Na primeira execução os valores são copiados para %APPDATA%\Comunicação DP\config.json.
# O valor salvo na tela Configurações do aplicativo tem prioridade sobre este arquivo.
SERVER_URL=http://localhost:3000
