# Configuração do banco PostgreSQL (docker-compose.postgres.yml).
# Copie para .env.postgres e troque a senha. O .env.postgres NÃO vai para o Git.

POSTGRES_DB=sistema_dp
POSTGRES_USER=sistema_dp

# Obrigatória. O instalar.sh gera uma sozinho; para gerar à mão, no Linux:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Porta do banco no servidor (só para acesso de fora, com psql ou pgAdmin).
# Dentro do Docker o backend fala com o banco na 5432, sempre.
POSTGRES_PORT=5433

# Porta do Adminer (interface web para consultar as tabelas)
ADMINER_PORT=8081

TZ=America/Sao_Paulo

# A conexão que o backend usa fica no .env (DATABASE_URL), escrita pelo instalar.sh:
#   DATABASE_URL=postgresql://sistema_dp:SUA_SENHA@sistema-dp-postgres:5432/sistema_dp
