# Configuração do banco PostgreSQL (docker-compose.postgres.yml).
# Copie para .env.postgres e troque a senha. O .env.postgres NÃO vai para o Git.

POSTGRES_DB=sistema_dp
POSTGRES_USER=sistema_dp

# Obrigatória. Gere uma senha longa e aleatória, por exemplo no PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % { [char]$_ })
POSTGRES_PASSWORD=

# Porta no Windows. A 5432 costuma estar ocupada por um Postgres instalado na máquina.
POSTGRES_PORT=5433

# Porta do Adminer (interface web para consultar as tabelas)
ADMINER_PORT=8081

TZ=America/Sao_Paulo

# String de conexão que o backend vai usar depois da migração:
#   DATABASE_URL=postgresql://sistema_dp:SUA_SENHA@localhost:5433/sistema_dp
